{
    "name": "argon",
    "version": "1.0.0",
    "main": "index.js",
    "author": "TheEscape <digital@the-escape.co.uk>",
    "license": "MIT",
    "private": true,
    "repository": "git@bitbucket.org:theescape/project-argon.git",
    "copyright": "TheEscape",
    "scripts": {
        "build": "node ./node_modules/gulp/bin/gulp.js",
        "js": "node ./node_modules/gulp/bin/gulp.js js",
        "css": "node ./node_modules/gulp/bin/gulp.js css",
        "demoHtml": "node ./node_modules/gulp/bin/gulp.js demoHtml",
        "watch": "node ./node_modules/gulp/bin/gulp.js watch",
        "serv": "node ./node_modules/gulp/bin/gulp.js serv"
    },
    "browserslist": [
        "> 1%",
        "last 2 versions",
        "not ie <= 8"
    ],
    "paths": {
        "src": {
            "base": "./resources/assets/",
            "css": "./resources/assets/sass/",
            "fonts": "./resources/assets/fonts/",
            "js": "./resources/assets/js/src/",
            "img": "./resources/assets/images/",
            "svgicons": "./resources/assets/svgicons/",
            "patterns": "./resources/patterns/patterns/",
            "data": "./resources/patterns/data/",
            "meta": "./resources/patterns/meta/",
            "annotations": "./resources/patterns/annotations",
            "styleguide": "./node_modules/styleguidekit-assets-default/dist/",
            "patternlabFiles": "./node_modules/styleguidekit-mustache-default/views/"
        },
        "build": {
            "base": "./build/",
            "css": "./build/css/",
            "js": "./build/js/",
            "productionCss": "./build/production/css/",
            "productionJs": "./build/production/js/"
        },
        "plPublic": {
            "base": "./patternlab/public/",
            "css": "./patternlab/public/css/",
            "fonts": "./patternlab/public/argon/fonts/",
            "js": "./patternlab/public/js/",
            "vendorjs": "./patternlab/public/vendor/",
            "img": "./patternlab/public/argon/images/",
            "patterns": "./patternlab/public/patterns/",
            "data": "./patternlab/public/styleguide/data/",
            "annotations": "./patternlab/public/annotations/",
            "styleguide": "./patternlab/public/styleguide/"
        },
        "public": {
            "base": "./public/",
            "css": "./public/css/",
            "fonts": "./public/fonts/",
            "js": "./public/js/",
            "vendorjs": "./public/vendor/",
            "img": "./public/images/"
        },
        "demo": {
            "base": "./html/",
            "css": "./html/css/",
            "fonts": "./html/fonts/",
            "js": "./html/js/",
            "vendorjs": "./html/vendor/",
            "img": "./html/images/"
        },
        "productionSrc": {
            "meta": "./resources/patterns/production-meta/",
            "pages": "./patternlab/pattern_exports/"
        }
    },
    "vars": {
        "cssName": "main.css",
        "scssName": "main.scss",
        "styleguideScssName": "styleguide.scss",
        "typographyScssName": "typography.scss",
        "typographyCssName": "typography.css",
        "prodJsName": "main.[chunkhash].js",
        "vendorChunkName": "vendor.[chunkhash].js",
        "bundledJsName": "main.js",
        "jsName": "index.js",
        "svgIconName": "svgicons.svg",
        "faviconName": "favicon.ico",
        "productionHeaderName": "header.html",
        "productionFooterName": "footer.html",
        "inlineJs": "libs.js"
    },
    "publicPaths": {
        "js": "/js/",
        "manifest": "/"
    },
    "globs": {
        "watchCss": [
            "./resources/assets/sass/**/*.scss",
            "./resources/assets/sass/*.css"
        ],
        "distCss": [
            "./build/css/*.css",
            "./resources/assets/sass/*.css",
            "!./build/css/typography.css",
            "!./build/css/old-cms.css"
        ],
        "distJs": [
            "./build/production/js/*.*"
        ],
        "prodDistCss": [
            "./build/css/*.css",
            "!./build/css/typography.css",
            "!./build/css/old-cms.css",
            "!./build/css/styleguide.css",
            "!./resources/assets/sass/pattern-scaffolding.css"
        ],
        "inlineJs": [
            "./node_modules/loadjs/dist/loadjs.min.js",
            "./node_modules/svg4everybody/dist/svg4everybody.min.js",
            "./resources/assets/vendor/pollyfills.js"
        ],
        "vendorJs": [
            "./node_modules/promise-polyfill/dist/polyfill.min.js",
            "./node_modules/whatwg-fetch/fetch.js",
            "./resources/assets/vendor/**/*",
            "./node_modules/jquery/dist/jquery.min.js"
        ]
    },
    "devDependencies": {
        "@babel/core": "^7.1.6",
        "@babel/plugin-proposal-object-rest-spread": "^7.0.0",
        "@babel/plugin-transform-object-assign": "^7.2.0",
        "@babel/preset-env": "^7.1.6",
        "autoprefixer": "^8.6.0",
        "babel-eslint": "^8.2.3",
        "babel-loader": "^8.0.4",
        "babel-minify-webpack-plugin": "^0.3.1",
        "browser-sync": "^2.24.4",
        "css-loader": "^1.0.1",
        "eslint": "^4.19.1",
        "eslint-config-standard": "^11.0.0",
        "eslint-plugin-import": "^2.12.0",
        "eslint-plugin-node": "^6.0.1",
        "eslint-plugin-promise": "^3.8.0",
        "eslint-plugin-standard": "^3.1.0",
        "eslint-plugin-vue": "^4.7.1",
        "fancy-log": "^1.3.2",
        "git-rev-sync": "^1.12.0",
        "gulp": "^4.0.0",
        "gulp-cached": "^1.1.1",
        "gulp-concat": "^2.6.1",
        "gulp-concat-multi": "^1.0.1",
        "gulp-cssnano": "^2.1.3",
        "gulp-header": "^2.0.5",
        "gulp-html-beautify": "^1.0.1",
        "gulp-plumber": "^1.2.0",
        "gulp-postcss": "^7.0.1",
        "gulp-print": "^5.0.0",
        "gulp-rev": "^8.1.1",
        "gulp-sass": "^4.0.1",
        "gulp-size": "^3.0.0",
        "gulp-sourcemaps": "^2.6.4",
        "gulp-svgstore": "^6.1.1",
        "mini-css-extract-plugin": "^0.4.4",
        "moment": "^2.22.2",
        "patternlab-node": "2.12.0",
        "prettier-stylelint": "^0.4.2",
        "styleguidekit-assets-default": "^3.5.2",
        "styleguidekit-mustache-default": "^3.1.0",
        "stylelint": "^9.2.1",
        "stylelint-config-standard": "^18.2.0",
        "stylelint-scss": "^3.1.0",
        "vue-loader": "^15.4.2",
        "vue-template-compiler": "^2.5.17",
        "webpack": "^4.10.2",
        "webpack-dev-middleware": "^3.1.3",
        "webpack-manifest-plugin": "^2.0.3",
        "webpack-stream": "^4.0.3"
    },
    "dependencies": {
        "animejs": "^2.2.0",
        "babel-plugin-transform-object-rest-spread": "^6.26.0",
        "babel-preset-es2015": "^6.24.1",
        "bower": "^1.8.4",
        "choices.js": "3.0.3",
        "ckeditor": "^4.9.2",
        "dragula": "^3.7.2",
        "filepond": "^3.3.3",
        "filepond-plugin-image-preview": "^3.1.4",
        "flatpickr": "^4.5.0",
        "jquery": "2.2.4",
        "loadjs": "^3.5.4",
        "lodash-webpack-plugin": "^0.11.5",
        "mathsass": "^0.10.1",
        "promise-polyfill": "^8.0.0",
        "rxjs": "^6.2.0",
        "svg4everybody": "^2.1.9",
        "vue": "^2.5.17",
        "vue-filepond": "^4.0.1",
        "vuebar": "0.0.20",
        "vue-flatpickr-component": "^8.0.0",
        "vuedraggable": "^2.16.0",
        "vuex": "^3.0.1",
        "webpack-bundle-analyzer": "^2.13.1",
        "whatwg-fetch": "^2.0.4",
        "vue-cropperjs": "^3.0.0",
        "noty": "^3.2.0-beta"
    }
}
