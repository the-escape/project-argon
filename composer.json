{
    "name": "escape/argon",
    "description": "The Escape's CMS.",
    "keywords": ["cms", "laravel", "argon"],
    "license": "Proprietary",
    "type": "project",
    "require": {
        "php": ">=7.1.3",
        "laravel/framework": "5.7.*",
        "prettus/l5-repository": "^2.1",
        "intervention/image":  "^2.5",
        "doctrine/dbal": "^2.5",
        "solarium/solarium":"^3.5.1",
        "symfony/options-resolver": "^4.0",
        "fideloper/proxy": "^4.0"
    },
    "require-dev": {
        "fzaninotto/faker": "~1.4",
        "phpunit/phpunit": "^7.0",
        "phpspec/phpspec": "~5.1",
        "symfony/dom-crawler": "^4.0",
        "symfony/css-selector": "^4.0",
        "filp/whoops": "~2.0"
    },
    "autoload": {
        "psr-4": {
            "Escape\\Argon\\Tests\\": "Tests",
            "Escape\\Argon\\": "src"
        },
        "files": [
            "src/helpers/guid.php",
            "src/helpers/Solr.php"
        ]
    },
    "autoload-dev": {
        "classmap": [
            "Tests/Cases/TestCase.php"
        ]
    },
    "config": {
        "preferred-install": "dist"
    }
}
