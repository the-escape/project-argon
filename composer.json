{
    "name": "escape/argon",
    "description": "The Escape's CMS.",
    "keywords": ["cms", "laravel", "argon"],
    "license": "Proprietary",
    "type": "project",
    "require": {
        "php": ">=8.0.2",
        "laravel/framework": "^9.0",
        "prettus/l5-repository": "^2.1",
        "intervention/image": "^2.5",
        "doctrine/dbal": "^2.5",
        "solarium/solarium":"^6.1",
        "alek13/slack": "^2.2",
        "symfony/options-resolver": "^5.0",
        "ps/image-optimizer": "^2.0.2",
        "laravel/ui": "^3.0"
    },
    "require-dev": {
        "fzaninotto/faker": "~1.4",
        "phpunit/phpunit": "^9.5",
        "laravel/laravel": "^7.0",
        "symfony/dom-crawler": "^5.0",
        "symfony/css-selector": "^5.0",
        "filp/whoops": "~2.14"
    },
    "autoload": {
        "psr-4": {
            "Escape\\Argon\\Tests\\": "Tests",
            "Escape\\Argon\\": "src"
        },
        "files": [
            "src/Helpers/Guid.php"
        ]
    },
    "autoload-dev": {
        "classmap": [
            "Tests/Cases/TestCase.php"
        ]
    },
    "config": {
        "preferred-install": "dist"
    }
}
