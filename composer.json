{
    "name": "escape/argon",
    "description": "The Escape's CMS.",
    "keywords": ["cms", "laravel", "argon"],
    "license": "Proprietary",
    "type": "project",
    "require": {
        "php": ">=7.2.5",
        "laravel/framework": "^7.0",
        "prettus/l5-repository": "^2.1",
        "intervention/image": "^2.5",
        "doctrine/dbal": "^2.5",
        "solarium/solarium":"^5.0",
        "maknz/slack": "^1.7",
        "symfony/options-resolver": "^5.0",
        "ps/image-optimizer": "^1.2",
        "fideloper/proxy": "^4.0",
        "laravel/ui": "^2.0"
    },
    "require-dev": {
        "fzaninotto/faker": "~1.4",
        "phpunit/phpunit": "^8.5",
        "phpspec/phpspec": "~6.1",
        "laravel/laravel": "^7.0",
        "symfony/dom-crawler": "^5.0",
        "symfony/css-selector": "^5.0",
        "filp/whoops": "~2.14"
    },
    "autoload": {
        "psr-4": {
            "Escape\\Argon\\Tests\\": "Tests",
            "Escape\\Argon\\": "src"
        },
        "files": [
            "src/helpers/guid.php",
            "src/helpers/Solr.php"
        ]
    },
    "autoload-dev": {
        "classmap": [
            "Tests/Cases/TestCase.php"
        ]
    },
    "config": {
        "preferred-install": "dist"
    }
}
