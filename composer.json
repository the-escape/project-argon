{
    "name": "escape/argon",
    "description": "The Escape's CMS.",
    "keywords": ["cms", "laravel", "argon"],
    "license": "Proprietary",
    "type": "project",
    "require": {
        "php": ">=5.5.9 < 7.0 || ^7.1.3",
        "laravel/framework": ">=5.1 <=5.8.* ",
        "prettus/l5-repository": "^2.1",
        "intervention/image": "^2.3",
        "doctrine/dbal": "^2.5",
        "solarium/solarium":"^3.5.1",
        "maknz/slack-laravel": "^1.0",
        "symfony/options-resolver": "2.1.*",
        "ps/image-optimizer": "^1.2"
    },
    "require-dev": {
        "fzaninotto/faker": "~1.4",
        "phpunit/phpunit": "~4.0",
        "laravel/laravel": "^5.1.0"
    },
    "autoload": {
        "psr-4": {
            "Escape\\Argon\\Tests\\": "Tests",
            "Escape\\Argon\\": "src"
        },
        "files": [
            "src/helpers/guid.php",
            "src/helpers/Solr.php"
        ]
    },
    "autoload-dev": {
        "classmap": [
            "Tests/Cases/TestCase.php"
        ]
    },
    "config": {
        "preferred-install": "dist"
    }
}
