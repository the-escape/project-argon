{
    "name": "escape/argon",
    "description": "The Escape's CMS.",
    "keywords": ["cms", "laravel", "argon"],
    "license": "Proprietary",
    "type": "project",
    "require": {
        "php": ">=5.5.9",
        "laravel/framework": "^5.1.11",
	"prettus/l5-repository": "^2.1",
	"intervention/image": "^2.3"
    },
    "require-dev": {
        "fzaninotto/faker": "~1.4",
        "phpunit/phpunit": "~4.0",
        "laravel/laravel": "^5.1.0"
    },
    "autoload": {
        "psr-4": {
            "Escape\\Argon\\Tests\\": "Tests",
            "Escape\\Argon\\": "src"
        }
    },
    "autoload-dev": {
        "classmap": [
            "Tests/Cases/TestCase.php"
        ]
    },
    "config": {
        "preferred-install": "dist"
    }
}
